{
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.7.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
    },
    "name": {
      "type": "string",
      "maxLength": 256
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "displayUnits": {
      "enum": [
        "SI",
        "engineeringMetric"
      ]
    },
    "analysisMode": {
      "enum": [
        "spatial",
        "planarXZ"
      ]
    },
    "gravity": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "materials": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/material"
      },
      "minItems": 1,
      "maxItems": 1000
    },
    "sections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/section"
      },
      "minItems": 1,
      "maxItems": 10000
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      },
      "minItems": 1,
      "maxItems": 5000
    },
    "members": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/member"
      },
      "minItems": 1,
      "maxItems": 10000
    },
    "supports": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/support"
      },
      "minItems": 0,
      "maxItems": 5000
    },
    "loadCases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/loadCase"
      },
      "minItems": 1,
      "maxItems": 100
    },
    "loads": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/load"
      },
      "minItems": 0,
      "maxItems": 100000
    },
    "combinations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/combination"
      },
      "minItems": 0,
      "maxItems": 500
    },
    "analysisSettings": {
      "$ref": "#/$defs/analysisSettings"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string",
          "maxLength": 4096
        },
        "createdBy": {
          "type": "string",
          "maxLength": 256
        },
        "entityLabels": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^(n|m|s|l|mat|sec|lc|c|ms|rs)[1-9][0-9]*$"
          }
        }
      },
      "required": [
        "description",
        "createdBy"
      ],
      "additionalProperties": false
    },
    "designPreviews": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/designPreview"
      }
    },
    "structure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "storeys",
        "physicalMembers",
        "grids",
        "layers",
        "groups",
        "joints",
        "supportDetails",
        "designObjects"
      ],
      "properties": {
        "storeys": {
          "type": "array",
          "maxItems": 25000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "elevation"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "elevation": {
                "type": "number"
              }
            }
          }
        },
        "physicalMembers": {
          "type": "array",
          "maxItems": 25000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "role",
              "storeyId",
              "analyticalMemberIds"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "role": {
                "enum": [
                  "unassigned",
                  "beam",
                  "column",
                  "brace",
                  "slab",
                  "stair",
                  "landing"
                ]
              },
              "storeyId": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "analyticalMemberIds": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
                }
              },
              "stairRisers": {
                "type": "integer",
                "minimum": 2,
                "maximum": 30
              }
            }
          }
        },
        "grids": {
          "type": "array",
          "maxItems": 25000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "start",
              "end"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "start": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 3,
                "maxItems": 3
              },
              "end": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 3,
                "maxItems": 3
              }
            }
          }
        },
        "layers": {
          "type": "array",
          "maxItems": 25000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "members"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "members": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "id"
                  ],
                  "properties": {
                    "kind": {
                      "enum": [
                        "physicalMember",
                        "designObject",
                        "joint",
                        "support",
                        "grid"
                      ]
                    },
                    "id": {
                      "type": "string",
                      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
                    }
                  }
                },
                "uniqueItems": true,
                "maxItems": 25000
              }
            }
          }
        },
        "groups": {
          "type": "array",
          "maxItems": 25000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "members"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "members": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "id"
                  ],
                  "properties": {
                    "kind": {
                      "enum": [
                        "physicalMember",
                        "designObject",
                        "joint",
                        "support",
                        "grid"
                      ]
                    },
                    "id": {
                      "type": "string",
                      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
                    }
                  }
                },
                "uniqueItems": true,
                "maxItems": 25000
              }
            }
          }
        },
        "joints": {
          "type": "array",
          "maxItems": 25000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "nodeId",
              "storeyId",
              "detailStatus"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "nodeId": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
              },
              "storeyId": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "detailStatus": {
                "const": "notDesigned"
              }
            }
          }
        },
        "supportDetails": {
          "type": "array",
          "maxItems": 25000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "supportId",
              "detailStatus"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "supportId": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
              },
              "detailStatus": {
                "const": "notDesigned"
              }
            }
          }
        },
        "designObjects": {
          "type": "array",
          "maxItems": 25000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "kind",
              "storeyId",
              "previewId",
              "physicalMemberId",
              "supportId",
              "analysisStatus"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "kind": {
                "enum": [
                  "rcBeam",
                  "rcColumn",
                  "slab",
                  "padFooting"
                ]
              },
              "storeyId": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "previewId": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
              },
              "physicalMemberId": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "supportId": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "analysisStatus": {
                "const": "unverified"
              }
            }
          }
        }
      }
    },
    "massSources": {
      "description": "Declared mass for modal analysis (ADR 0018, docs/formulations/modal.md). Absent means none; mass is never implied.",
      "type": "array",
      "maxItems": 5000,
      "items": {
        "$ref": "#/$defs/massSource"
      }
    },
    "responseSpectra": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/responseSpectrum"
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "name",
    "revision",
    "displayUnits",
    "analysisMode",
    "gravity",
    "materials",
    "sections",
    "nodes",
    "members",
    "supports",
    "loadCases",
    "loads",
    "combinations",
    "analysisSettings",
    "metadata",
    "structure"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://structural-workbench.invalid/contracts/project.schema.json",
  "title": "Analysis MVP project format",
  "description": "All engineering numbers use SI. Cross-reference and physical semantics require the checks in SPECIFICATION section 6.",
  "$defs": {
    "material": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "name": {
          "type": "string",
          "maxLength": 256
        },
        "E": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "nu": {
          "type": "number",
          "exclusiveMinimum": -1,
          "exclusiveMaximum": 0.5
        },
        "density": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "id",
        "name",
        "E",
        "nu",
        "density"
      ],
      "additionalProperties": false
    },
    "section": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "name": {
          "type": "string",
          "maxLength": 256
        },
        "A": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "Iy": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "Iz": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "J": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "cy": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "cz": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "provenance": {
          "type": "string",
          "maxLength": 256
        }
      },
      "required": [
        "id",
        "name",
        "A",
        "Iy",
        "Iz",
        "J",
        "cy",
        "cz",
        "provenance"
      ],
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "position": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        }
      },
      "required": [
        "id",
        "position"
      ],
      "additionalProperties": false
    },
    "member": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "start": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "end": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "material": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "section": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "localY": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "releaseStart": {
          "type": "object",
          "properties": {
            "my": {
              "type": "boolean"
            },
            "mz": {
              "type": "boolean"
            }
          },
          "required": [
            "my",
            "mz"
          ],
          "additionalProperties": false
        },
        "releaseEnd": {
          "type": "object",
          "properties": {
            "my": {
              "type": "boolean"
            },
            "mz": {
              "type": "boolean"
            }
          },
          "required": [
            "my",
            "mz"
          ],
          "additionalProperties": false
        },
        "parentMemberId": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "stationRange": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "steelDesign": {
          "$ref": "#/$defs/steelDesign"
        }
      },
      "required": [
        "id",
        "start",
        "end",
        "material",
        "section",
        "localY",
        "releaseStart",
        "releaseEnd"
      ],
      "additionalProperties": false
    },
    "support": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "node": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "fixed": {
          "type": "array",
          "items": {
            "type": "boolean"
          },
          "minItems": 6,
          "maxItems": 6
        },
        "prescribed": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 6,
          "maxItems": 6
        }
      },
      "required": [
        "id",
        "node",
        "fixed",
        "prescribed"
      ],
      "additionalProperties": false
    },
    "loadCase": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "name": {
          "type": "string",
          "maxLength": 256
        },
        "category": {
          "enum": [
            "dead",
            "live",
            "wind",
            "other"
          ]
        }
      },
      "required": [
        "id",
        "name",
        "category"
      ],
      "additionalProperties": false
    },
    "load": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
            },
            "case": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
            },
            "type": {
              "const": "nodal"
            },
            "node": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
            },
            "values": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 6,
              "maxItems": 6
            }
          },
          "required": [
            "id",
            "case",
            "type",
            "node",
            "values"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
            },
            "case": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
            },
            "type": {
              "const": "uniform"
            },
            "member": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
            },
            "axes": {
              "enum": [
                "global",
                "local"
              ]
            },
            "forcePerLength": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            }
          },
          "required": [
            "id",
            "case",
            "type",
            "member",
            "axes",
            "forcePerLength"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
            },
            "case": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
            },
            "type": {
              "const": "point"
            },
            "member": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
            },
            "axes": {
              "enum": [
                "global",
                "local"
              ]
            },
            "station": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "values": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 6,
              "maxItems": 6
            }
          },
          "required": [
            "id",
            "case",
            "type",
            "member",
            "axes",
            "station",
            "values"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
            },
            "case": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
            },
            "type": {
              "const": "selfWeight"
            },
            "members": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
              },
              "minItems": 1,
              "maxItems": 10000
            },
            "factor": {
              "type": "number"
            }
          },
          "required": [
            "id",
            "case",
            "type",
            "members",
            "factor"
          ],
          "additionalProperties": false
        }
      ]
    },
    "combination": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "name": {
          "type": "string",
          "maxLength": 256
        },
        "purpose": {
          "enum": [
            "analysis",
            "service",
            "strength"
          ]
        },
        "terms": {
          "type": "array",
          "items": {
