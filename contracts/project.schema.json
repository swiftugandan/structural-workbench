{
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
    },
    "name": {
      "type": "string",
      "maxLength": 256
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "displayUnits": {
      "enum": [
        "SI",
        "engineeringMetric"
      ]
    },
    "analysisMode": {
      "enum": [
        "spatial",
        "planarXZ"
      ]
    },
    "gravity": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "materials": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/material"
      },
      "minItems": 1,
      "maxItems": 1000
    },
    "sections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/section"
      },
      "minItems": 1,
      "maxItems": 10000
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      },
      "minItems": 1,
      "maxItems": 5000
    },
    "members": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/member"
      },
      "minItems": 1,
      "maxItems": 10000
    },
    "supports": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/support"
      },
      "minItems": 0,
      "maxItems": 5000
    },
    "loadCases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/loadCase"
      },
      "minItems": 1,
      "maxItems": 100
    },
    "loads": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/load"
      },
      "minItems": 0,
      "maxItems": 100000
    },
    "combinations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/combination"
      },
      "minItems": 0,
      "maxItems": 500
    },
    "analysisSettings": {
      "$ref": "#/$defs/analysisSettings"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string",
          "maxLength": 4096
        },
        "createdBy": {
          "type": "string",
          "maxLength": 256
        }
      },
      "required": [
        "description",
        "createdBy"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "name",
    "revision",
    "displayUnits",
    "analysisMode",
    "gravity",
    "materials",
    "sections",
    "nodes",
    "members",
    "supports",
    "loadCases",
    "loads",
    "combinations",
    "analysisSettings",
    "metadata"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://structural-workbench.invalid/contracts/project.schema.json",
  "title": "Analysis MVP project format",
  "description": "All engineering numbers use SI. Cross-reference and physical semantics require the checks in SPECIFICATION section 6.",
  "$defs": {
    "material": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "name": {
          "type": "string",
          "maxLength": 256
        },
        "E": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "nu": {
          "type": "number",
          "exclusiveMinimum": -1,
          "exclusiveMaximum": 0.5
        },
        "density": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "id",
        "name",
        "E",
        "nu",
        "density"
      ],
      "additionalProperties": false
    },
    "section": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "name": {
          "type": "string",
          "maxLength": 256
        },
        "A": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "Iy": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "Iz": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "J": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "cy": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "cz": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "provenance": {
          "type": "string",
          "maxLength": 256
        }
      },
      "required": [
        "id",
        "name",
        "A",
        "Iy",
        "Iz",
        "J",
        "cy",
        "cz",
        "provenance"
      ],
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "position": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        }
      },
      "required": [
        "id",
        "position"
      ],
      "additionalProperties": false
    },
    "member": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "start": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "end": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "material": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "section": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "localY": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "releaseStart": {
          "type": "object",
          "properties": {
            "my": {
              "type": "boolean"
            },
            "mz": {
              "type": "boolean"
            }
          },
          "required": [
            "my",
            "mz"
          ],
          "additionalProperties": false
        },
        "releaseEnd": {
          "type": "object",
          "properties": {
            "my": {
              "type": "boolean"
            },
            "mz": {
              "type": "boolean"
            }
          },
          "required": [
            "my",
            "mz"
          ],
          "additionalProperties": false
        },
        "parentMemberId": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "stationRange": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      },
      "required": [
        "id",
        "start",
        "end",
        "material",
        "section",
        "localY",
        "releaseStart",
        "releaseEnd"
      ],
      "additionalProperties": false
    },
    "support": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "node": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "fixed": {
          "type": "array",
          "items": {
            "type": "boolean"
          },
          "minItems": 6,
          "maxItems": 6
        },
        "prescribed": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 6,
          "maxItems": 6
        }
      },
      "required": [
        "id",
        "node",
        "fixed",
        "prescribed"
      ],
      "additionalProperties": false
    },
    "loadCase": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "name": {
          "type": "string",
          "maxLength": 256
        },
        "category": {
          "enum": [
            "dead",
            "live",
            "wind",
            "other"
          ]
        }
      },
      "required": [
        "id",
        "name",
        "category"
      ],
      "additionalProperties": false
    },
    "load": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
            },
            "case": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
            },
            "type": {
              "const": "nodal"
            },
            "node": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
            },
            "values": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 6,
              "maxItems": 6
            }
          },
          "required": [
            "id",
            "case",
            "type",
            "node",
            "values"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
            },
            "case": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
            },
            "type": {
              "const": "uniform"
            },
            "member": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
            },
            "axes": {
              "enum": [
                "global",
                "local"
              ]
            },
            "forcePerLength": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            }
          },
          "required": [
            "id",
            "case",
            "type",
            "member",
            "axes",
            "forcePerLength"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
            },
            "case": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
            },
            "type": {
              "const": "point"
            },
            "member": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
            },
            "axes": {
              "enum": [
                "global",
                "local"
              ]
            },
            "station": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "values": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 6,
              "maxItems": 6
            }
          },
          "required": [
            "id",
            "case",
            "type",
            "member",
            "axes",
            "station",
            "values"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
            },
            "case": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
            },
            "type": {
              "const": "selfWeight"
            },
            "members": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
              },
              "minItems": 1,
              "maxItems": 10000
            },
            "factor": {
              "type": "number"
            }
          },
          "required": [
            "id",
            "case",
            "type",
            "members",
            "factor"
          ],
          "additionalProperties": false
        }
      ]
    },
    "combination": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "name": {
          "type": "string",
          "maxLength": 256
        },
        "purpose": {
          "enum": [
            "analysis",
            "service",
            "strength"
          ]
        },
        "terms": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "case": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
              },
              "factor": {
                "type": "number"
              }
            },
            "required": [
              "case",
              "factor"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 100
        }
      },
      "required": [
        "id",
        "name",
        "purpose",
        "terms"
      ],
      "additionalProperties": false
    },
    "analysisSettings": {
      "type": "object",
      "properties": {
        "type": {
          "const": "linearStatic"
        },
        "formulation": {
          "const": "eulerBernoulli3D"
        },
        "mergeTolerance": {
          "const": 1e-06
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 30000
        },
        "memoryLimitMiB": {
          "type": "integer",
          "minimum": 64,
          "maximum": 512
        }
      },
      "required": [
        "type",
        "formulation",
        "mergeTolerance",
        "timeoutMs",
        "memoryLimitMiB"
      ],
      "additionalProperties": false
    }
  },
  "$comment": "The invalid domain is an identifier, not a downloadable endpoint."
}
